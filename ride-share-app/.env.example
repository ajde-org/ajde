# Supabase -- Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# The public key. New projects issue `sb_publishable_...`; older ones issue a
# legacy `anon` JWT (eyJ...), which goes in NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# Either variable works -- see lib/supabase/env.ts.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS -- used by seed/admin scripts and the no-email Sign in, never sent to the browser.
SUPABASE_SECRET_KEY=
# Legacy alternative for projects that have not created an sb_secret_ key yet.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres, for psql and migrations. Use the Session pooler string (port 5432):
# the direct db.<ref>.supabase.co host is IPv6-only and will not resolve on
# most laptops or on Vercel's build machines.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Server-only calculator assumptions. Set these to the verified current pump prices before demoing.
FUEL_PRICE_PETROL_MKD_L=
FUEL_PRICE_DIESEL_MKD_L=

# Comma-separated, exact domains accepted by the server-side magic-link flow.
STUDENT_EMAIL_DOMAINS=students.finki.ukim.mk,student.finki.ukim.mk

# Server-only OpenAI credentials for location fallback and ride-post parsing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_LOCATION_MODEL=gpt-5-mini
OPENAI_SEARCH_MODEL=gpt-5.4-mini
OPENAI_EXPLAIN_MODEL=gpt-5.4-mini

# Server-only import pipeline. Only exact true enables it; restart the server after changing.
AI_IMPORT_PIPELINE_ENABLED=true
# Optional checker override; falls back to OPENAI_MODEL, then verified gpt-5.4-mini.
OPENAI_CHECK_MODEL=
# Optional chat summary/question override; otherwise uses OPENAI_MODEL.
OPENAI_CHAT_MODEL=

# Disable chat summaries/questions in both UI and API; restart/redeploy after changing.
CHAT_AI_ENABLED=true

# AI operation protection. Enable the kill switch during migration/deployment work.
AI_KILL_SWITCH=false
# Optional rolling-24-hour monetary controls: select from the launch budget first.
# These are protective thresholds, not exact billing ceilings; leave blank to disable.
AI_SPEND_ALERT_USD=
AI_SPEND_CUTOFF_USD=
# Required ISO timestamp with offset when either monetary threshold is configured.
AI_SPEND_POLICY_EFFECTIVE_AT=
# Set only when production enforcement and telemetry have actually been enabled.
# The local report marks comparison coverage unverified while this is blank.
AI_TELEMETRY_ENABLED_AT=
# Vercel sends this Bearer secret to the daily metadata cleanup endpoint.
# Configure 32–200 random characters in production; never expose it to the browser.
CRON_SECRET=
